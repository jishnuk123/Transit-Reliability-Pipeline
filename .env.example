# Copy this file to .env and fill in real values. Never commit the actual .env file.

# Snowflake connection
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=TRANSIT_WH
SNOWFLAKE_DATABASE=TRANSIT_PIPELINE
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_SCHEMA_ANALYTICS=ANALYTICS

# dbt profile location inside the Airflow container (do not change)
DBT_PROFILES_DIR=/usr/local/airflow/include/transit_dbt

# Email alerting (Gmail SMTP)
# ALERT_EMAIL_APP_PASSWORD must be a Gmail "App Password", not your normal
# account password. Generate one at myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled first).
ALERT_EMAIL_ADDRESS=your_email@gmail.com
ALERT_EMAIL_APP_PASSWORD=your16charapppassword
